// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "mistral-vibe": {
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "git_panel": {
    "tree_view": true
  },
  "always_treat_brackets_as_autoclosed": true,
  "colorize_brackets": true,
  "show_signature_help_after_edits": true,
  "icon_theme": "Catppuccin Latte",
  "theme": {
    "mode": "light",
    "light": "Kanagawa Lotus",
    "dark": "Kanagawa Wave"
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "agent": {
    "default_profile": "write",
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6-latest",
        "enable_thinking": false
      },
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6-thinking-latest",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
        "enable_thinking": false
      },
      {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-thinking-latest",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": false
      }
    ],
    "default_model": {
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-haiku-4-5-thinking-latest"
    }
  },
  "minimap": {
    "show": "auto"
  },
  "soft_wrap": "editor_width",
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "ui_font_size": 13,
  "buffer_font_size": 13.0,
  "buffer_font_family": "Hack Nerd Font",
  "cursor_blink": true,
  "experimental.theme_overrides": {},
  "git": {
    "inline_blame": {
      "enabled": true,
      "min_column": 150
    }
  },
  "project_panel": {
    "indent_size": 12
  },
  "terminal": {
    "font_family": "Hack Nerd Font",
    "font_size": null,
    "line_height": "comfortable",
    "detect_venv": {
      "on": {
        // Default directories to search for virtual environments, relative
        // to the current working directory. We recommend overriding this
        // in your project's settings, rather than globally.
        "directories": [".venv", "venv"],
        // Can also be `csh`, `fish`, and `nushell`
        "activate_script": "fish"
      }
    }
  },
  // "vim_mode": true,
  "autosave": "on_focus_change",
  "tabs": {
    "git_status": true
  },
  "tab_size": 2,
  "languages": {
    "Markdown": {
      "format_on_save": "on"
    },
    "Python": {
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": [
            "check",
            "--select=I",
            "--exit-zero",
            "--fix",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      },
      "format_on_save": "on"
    }
  },
  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/host_vars/*.yml",
      "**/host_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml"
    ],
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml"
    ]
  },
  "lsp": {
    "ansible-language-server": {
      "settings": {
        "ansible": {
          "path": "ansible"
        },
        "executionEnvironment": {
          "enabled": false
        },
        "python": {
          "interpreterPath": "python3"
        },
        "validation": {
          "enabled": true,
          "lint": {
            "enabled": true,
            "path": "ansible-lint"
          }
        }
      }
    }
  }
}
